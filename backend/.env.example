# ---------------- Required ----------------
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/loginSystem

# Must be 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server REFUSES TO START while this is empty, short, or a placeholder.
JWT_SECRET=

# Exact origin of the website (no trailing path). Used for CORS and reset links.
FRONTEND_URL=http://127.0.0.1:5500
# VS Code Dev Tunnel: FRONTEND_URL=https://760kvg4q-5501.inc1.devtunnels.ms

# ---------------- Production ----------------
# NODE_ENV=production requires an https:// FRONTEND_URL and disables the
# localhost development CORS origins.
NODE_ENV=development

# Number of reverse proxies in front of the API (Render, Heroku, Nginx,
# Cloudflare = 1). Without it every visitor shares one rate-limit bucket.
# Leave at 0 when the API is exposed directly (otherwise clients could spoof
# X-Forwarded-For to evade rate limits).
TRUST_PROXY=0

# ---------------- Email (Resend) ----------------
# In Resend's test mode mail only reaches your own address - verify a domain
# before launch.
RESEND_API_KEY=
RESEND_FROM=Dream CV <onboarding@resend.dev>
